# Copy to .env.local and fill in. Never commit real values.
# Real values for preview, demo and production live in Vercel.

# Neon Postgres (a personal Neon branch for local work)
DATABASE_URL=

# Better Auth
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Email (Resend). Leave both blank to print sign-in links in development.
RESEND_API_KEY=
EMAIL_FROM=

# Payments (Stripe). Use test-mode keys (sk_test_...) everywhere but
# production; test mode never charges a card. Leave both blank to keep
# checkout off. Locally, `stripe listen` prints the webhook secret.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
