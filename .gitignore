# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/.next-demo/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# npm run demo: its throwaway secrets and state
/.demo/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# League material kept private until the league agrees to publish it
docs/BKC_Rulebook_2023.pdf
/private/
# npm run demo copies a private logo here (docs/demo.md)
/public/brand/

# Playwright
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# Lighthouse CI
/.lighthouseci/

# Database backups hold personal data; they never belong in the repository
*.dump
/backups/

# The native apps' generated pages (npm run mobile:web) and build output
/mobile/www/
/ios/App/App/public/
/ios/App/App/capacitor.config.json
/ios/App/App/config.xml
/android/app/src/main/assets/public/
/android/app/src/main/assets/capacitor.config.json
/android/app/src/main/assets/capacitor.plugins.json
/android/.gradle/
/android/build/
/android/app/build/
/android/local.properties
